# Copy this file to .env on the server (never commit .env).
# On AWS you can instead set these in Elastic Beanstalk "Environment properties",
# App Runner / ECS task env vars, or a systemd EnvironmentFile on EC2.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Public URL of the site (used for canonical link, sitemap, social previews)
SITE_URL=https://www.your-domain.com

# Admin panel: "true" to enable /admin. In production it stays disabled
# while the admin account still has the default password.
ADMIN_ENABLED=false
# Sets / rotates the "admin" user's password on startup. Use a long random value.
ADMIN_PASSWORD=

# Optional: keep data outside the code folder so redeploys don't wipe it
# (e.g. on an attached EBS volume or EFS mount)
# DB_PATH=/var/app/data/mepia.db
# UPLOADS_DIR=/var/app/data/uploads
